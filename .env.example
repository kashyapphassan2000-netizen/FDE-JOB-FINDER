# ================= REQUIRED =================
# Your login password for the dashboard (only you know it)
APP_PASSWORD=
# Random 32+ char string used to sign your session cookie  (generate: openssl rand -hex 32)
AUTH_SECRET=
# Random 32+ char string protecting /api/cron (also used by Vercel Cron + GitHub Action)
CRON_SECRET=

# ================= STORAGE (Vercel → Storage tab; injected automatically when you connect) =================
# Upstash for Redis (Marketplace) – tracker, settings, job cache
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (or) UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob (PRIVATE store) – your CV versions. On Vercel this is automatic (OIDC) once the store is connected.
BLOB_READ_WRITE_TOKEN=

# ================= OPTIONAL JOB APIs (each adds coverage) =================
RAPIDAPI_KEY=            # JSearch: LinkedIn/Indeed/Glassdoor/Naukri via Google for Jobs (free 200 req/mo)
SERPAPI_KEY=             # SerpApi Google Jobs: Naukri, Foundit, Shine, iimjobs, Hirist, Cutshort, Wellfound (free 250/mo)
ADZUNA_APP_ID=           # Adzuna India (free)
ADZUNA_APP_KEY=
JOOBLE_API_KEY=          # Jooble India (free)
APIFY_TOKEN=             # Apify LinkedIn scraper (paid per result, $5 free credit/mo)
X_BEARER_TOKEN=          # X official API v2 (pay-per-use credits)
TWITTERAPI_IO_KEY=       # twitterapi.io – cheap X search alternative
THEMUSE_API_KEY=         # optional, raises The Muse rate limit

# ================= AI PROVIDER (optional here — easier: add in the app → "AI & Keys") =================
# Any of these creates a provider automatically. Order of fallback = app list first, then these.
GEMINI_API_KEY=          # free tier — https://aistudio.google.com/apikey
GROQ_API_KEY=            # free tier — https://console.groq.com/keys
OPENROUTER_API_KEY=      # free ':free' models — https://openrouter.ai/keys
ANTHROPIC_API_KEY=       # Claude (paid)
OPENAI_API_KEY=          # OpenAI (paid)
# Any third party (OpenAI- or Anthropic-compatible):
# LLM_PROVIDER=custom-openai   # or custom-anthropic / gemini / groq / openrouter / anthropic / openai / mistral / deepseek / together / xai / nvidia / cerebras
# LLM_BASE_URL=https://api.your-provider.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_WIRE=openai              # or anthropic

# ================= WEB SEARCH for the AI agent (need at least ONE; all have free tiers) =================
TAVILY_API_KEY=          # 1,000 searches/month free, no card
FIRECRAWL_API_KEY=       # free monthly credits
EXA_API_KEY=             # free monthly credits
LINKUP_API_KEY=          # free monthly credits
SERPER_API_KEY=          # 2,500 free (one-time)
BRAVE_API_KEY=           # $5 monthly credit (card required)
JINA_API_KEY=            # search + higher page-reader limits
SEARXNG_URL=             # your own SearXNG instance = unlimited
# AGENT_INTERVAL_MIN=180 # how often cron runs the next agent mission

# ================= DAILY JOB EMAIL (top fresh jobs, CV-matched; also settable in the app → "AI & Keys") =================
RESEND_API_KEY=          # free 100 emails/day — https://resend.com/api-keys (sign up with the SAME email you put in DIGEST_TO)
DIGEST_TO=               # where the daily email goes
# DIGEST_FROM=           # only with your own verified domain in Resend; default onboarding@resend.dev
# APP_URL=               # your site URL, linked at the bottom of the email

# ================= OPTIONAL ALERTS =================
TELEGRAM_BOT_TOKEN=      # from @BotFather
TELEGRAM_CHAT_ID=        # your chat id (see PDF)
ALERT_WEBHOOK_URL=       # Discord/Slack incoming webhook (optional)

# ================= OPTIONAL TUNING (minutes between runs of quota-limited sources) =================
# JSEARCH_INTERVAL_MIN=720
# SERPAPI_INTERVAL_MIN=720
# ADZUNA_INTERVAL_MIN=120
# JOOBLE_INTERVAL_MIN=120
# APIFY_INTERVAL_MIN=720
# APIFY_LINKEDIN_LIMIT=25
# X_INTERVAL_MIN=720
# X_MAX_RESULTS=10
# TWITTERAPI_IO_INTERVAL_MIN=120
